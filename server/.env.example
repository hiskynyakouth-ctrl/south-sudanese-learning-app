## Server
PORT=5051
NODE_ENV=development

## MongoDB
MONGO_URI=mongodb://localhost:27017/elearning
DATABASE_URL=

# Production example for MongoDB Atlas:
# MONGO_URI=mongodb+srv://username:password@cluster0.example.mongodb.net/elearning
# Do not wrap the URI in quotes when setting it in Render or other platforms.

## App
CLIENT_URL=https://your-frontend-app.vercel.app
JWT_SECRET=your_jwt_secret_here

## Gmail (for password reset emails)
GMAIL_USER=your@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

## SMTP (alternative email provider)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your@smtp-user.com
SMTP_PASSWORD=your-smtp-password

## Twilio SMS (optional)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxx
TWILIO_PHONE=+1xxxxxxxxxx

## TextBelt SMS (free fallback or paid key)
TEXTBELT_KEY=textbelt
