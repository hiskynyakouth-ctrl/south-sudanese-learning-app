{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "build"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://south-sudanese-learning-app-sqdw.onrender.com/api/$1"
    },
    {
      "src": "/uploads/(.*)",
      "dest": "https://south-sudanese-learning-app-sqdw.onrender.com/uploads/$1"
    },
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
